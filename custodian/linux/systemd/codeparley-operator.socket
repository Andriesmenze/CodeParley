# Phase 5 (contract §4.2): the operator surface of the CodeParley custodian — the separate operator account's (D5-B)
# only way to the custodian. codeparley:codeparley-op 0660 in the root-owned runtime directory.
[Unit]
Description=CodeParley custodian (operator socket)

[Socket]
ListenStream=/run/codeparley/operator.sock
FileDescriptorName=operator
SocketUser=codeparley
SocketGroup=codeparley-op
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no
Service=codeparley-custodian.service

[Install]
WantedBy=sockets.target
