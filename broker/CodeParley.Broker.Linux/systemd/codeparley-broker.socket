# CodeParley Linux broker — listening IPC socket (Phase 3.1B).
# Root-owned, group = the controller group, mode 0660: only root and the controller account may
# connect. Accept=yes spawns one short-lived codeparley-broker@.service instance per connection,
# with the accepted connection on its stdin. Worker run units are BindsTo= this socket, so stopping
# the broker (this socket) stops every worker run.
[Unit]
Description=CodeParley broker IPC socket
Documentation=file:/opt/codeparley-broker/README.md

[Socket]
ListenStream=/run/codeparley-broker.sock
SocketUser=root
SocketGroup=codeparley
SocketMode=0660
Accept=yes
MaxConnectionsPerSource=0
Backlog=16

[Install]
WantedBy=sockets.target
